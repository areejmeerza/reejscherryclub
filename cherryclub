<script>
/* =========================================================
   SUPABASE
========================================================= */
const SUPABASE_URL =
  "https://jqpkvttexoekaoylwtkg.supabase.co";
const SUPABASE_PUBLISHABLE_KEY =
  "sb_publishable_QzAhQAxVVhrOdR0zhPbHBg_5c0LDxKF";
const supabaseClient =
  supabase.createClient(
    SUPABASE_URL,
    SUPABASE_PUBLISHABLE_KEY
  );
/* =========================================================
   SETTINGS
========================================================= */
const DELIVERY_FEE = 370;
const JAZZCASH_NAME =
  "Areej Fatima";
const JAZZCASH_NUMBER =
  "03054400537";
/* =========================================================
   STATE
========================================================= */
let products = [];
let cart = [];
let activeCategory = "all";
/* =========================================================
   HELPERS
========================================================= */
function escapeHTML(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}
function formatPrice(value) {
  return Number(value || 0)
    .toLocaleString("en-PK");
}
function getProductImage(product) {
  return product.image_url || "";
}
/* =========================================================
   LOAD PRODUCTS
========================================================= */
async function loadProducts() {
  const container =
    document.getElementById(
      "products-container"
    );
  const {
    data,
    error
  } = await supabaseClient
    .from("products")
    .select("*")
    .eq("status", "available")
    .order(
      "created_at",
      {
        ascending: false
      }
    );
  console.log("PRODUCT DATA:", data);
  console.log("PRODUCT ERROR:", error);
  if (error) {
    console.error(
      "Product loading error:",
      error
    );
    container.innerHTML = `
      <p style="
        grid-column:1/-1;
        text-align:center;
        color:#888;
      ">
        Unable to load the drop right now 🍒
      </p>
    `;
    return;
  }
  products = data || [];
  renderProducts();
}
/* =========================================================
   RENDER PRODUCTS
========================================================= */
function renderProducts() {
  const container =
    document.getElementById(
      "products-container"
    );
  if (!container) return;
  let visibleProducts =
    products.slice();
  if (activeCategory !== "all") {
    visibleProducts =
      products.filter(product => {
        const category =
          String(
            product.category || ""
          ).toLowerCase();
        const name =
          String(
            product.name || ""
          ).toLowerCase();
        const wanted =
          activeCategory.toLowerCase();
        return (
          category.includes(wanted) ||
          name.includes(wanted)
        );
      });
  }
  if (!visibleProducts.length) {
    container.innerHTML = `
      <p style="
        grid-column:1/-1;
        text-align:center;
        color:#888;
        padding:50px 0;
      ">
        Nothing here yet 🍒
      </p>
    `;
    return;
  }
  container.innerHTML =
    visibleProducts
      .map(productCard)
      .join("");
}
/* =========================================================
   PRODUCT CARD
========================================================= */
function productCard(product) {
  const image =
    getProductImage(product);
  return `
    <article
      class="product"
      onclick="openProduct('${escapeHTML(product.id)}')"
    >
      <div class="product-image">
        ${
          image
          ?
          `
            <img
              src="${escapeHTML(image)}"
              alt="${escapeHTML(product.name)}"
              loading="lazy"
            >
          `
          :
          `
            <div class="product-placeholder">
              🍒
            </div>
          `
        }
        ${
          product.status === "available"
          ?
          `
            <div class="tag">
              Available
            </div>
          `
          :
          ""
        }
      </div>
      <div class="product-info">
        <div>
          <div class="product-name">
            ${escapeHTML(product.name)}
          </div>
          <div class="product-meta">
            ${escapeHTML(
              product.category || ""
            )}
            ${
              product.size
                ? " · " +
                  escapeHTML(
                    product.size
                  )
                : ""
            }
          </div>
        </div>
        <div class="price">
          Rs.
          ${formatPrice(product.price)}
        </div>
      </div>
    </article>
  `;
}
/* =========================================================
   CATEGORY FILTER
========================================================= */
function filterCategory(category) {
  closeMenu();
  activeCategory =
    String(category || "all");
  const title =
    document.getElementById(
      "shop-title"
    );
  if (title) {
    title.textContent =
      activeCategory === "all"
        ? "The Drop"
        : activeCategory;
  }
  renderProducts();
  setTimeout(() => {
    document
      .getElementById("shop")
      ?.scrollIntoView({
        behavior: "smooth"
      });
  }, 100);
}
function showAllProducts() {
  activeCategory = "all";
  const title =
    document.getElementById(
      "shop-title"
    );
  if (title) {
    title.textContent =
      "The Drop";
  }
  renderProducts();
}
/* =========================================================
   PRODUCT DETAIL
========================================================= */
function openProduct(productId) {
  const product =
    products.find(
      item =>
        String(item.id) ===
        String(productId)
    );
  if (!product) {
    console.error(
      "Product not found:",
      productId
    );
    return;
  }
  const overlay =
    document.getElementById(
      "productOverlay"
    );
  const content =
    document.getElementById(
      "product-detail-content"
    );
  const image =
    getProductImage(product);
  const suggestions =
    products
      .filter(
        item =>
          String(item.id) !==
          String(product.id)
      )
      .slice(0, 4);
  content.innerHTML = `
    <div class="detail-grid">
      <div>
        ${
          image
          ?
          `
            <img
              class="detail-image"
              src="${escapeHTML(image)}"
              alt="${escapeHTML(product.name)}"
            >
          `
          :
          `
            <div
              class="detail-image"
              style="
                display:flex;
                align-items:center;
                justify-content:center;
                font-size:80px;
              "
            >
              🍒
            </div>
          `
        }
      </div>
      <div class="detail-info">
        <div class="detail-category">
          ${escapeHTML(
            product.category ||
            "Cherry Club"
          )}
        </div>
        <h1 class="detail-name">
          ${escapeHTML(
            product.name
          )}
        </h1>
        <div class="detail-price">
          Rs.
          ${formatPrice(product.price)}
        </div>
        <p class="detail-description">
          ${escapeHTML(
            product.description ||
            "A carefully picked Cherry Club piece. One of one, made to be worn your way. 🍒"
          )}
        </p>
        ${
          product.size
          ?
          `
            <div class="detail-info-row">
              <span>Size</span>
              <strong>
                ${escapeHTML(
                  product.size
                )}
              </strong>
            </div>
          `
          :
          ""
        }
        ${
          product.condition
          ?
          `
            <div class="detail-info-row">
              <span>Condition</span>
              <strong>
                ${escapeHTML(
                  product.condition
                )}
              </strong>
            </div>
          `
          :
          ""
        }
        <div class="detail-info-row">
          <span>Delivery</span>
          <strong>
            Rs. ${DELIVERY_FEE}
          </strong>
        </div>
        <button
          class="primary-button"
          onclick="addToBag('${escapeHTML(product.id)}');closeProduct();"
        >
          Add to Bag →
        </button>
      </div>
    </div>
    <div class="suggestions">
      <div class="section-kicker">
        You might also like
      </div>
      <h2>
        More cherries.
      </h2>
      <div class="products">
        ${
          suggestions
            .map(productCard)
            .join("")
        }
      </div>
    </div>
  `;
  overlay.classList.add("active");
  document.body.classList.add(
    "no-scroll"
  );
}
function closeProduct() {
  document
    .getElementById(
      "productOverlay"
    )
    .classList.remove(
      "active"
    );
  document.body.classList.remove(
    "no-scroll"
  );
}
/* =========================================================
   CART STORAGE
========================================================= */
function saveCart() {
  localStorage.setItem(
    "cherryClubCart",
    JSON.stringify(cart)
  );
}
function loadCart() {
  try {
    const saved =
      localStorage.getItem(
        "cherryClubCart"
      );
    if (saved) {
      cart =
        JSON.parse(saved);
    }
  } catch {
    cart = [];
  }
}
/* =========================================================
   ADD TO BAG
========================================================= */
function addToBag(productId) {
  const product =
    products.find(
      item =>
        String(item.id) ===
        String(productId)
    );
  if (!product) {
    alert(
      "This piece could not be found."
    );
    return;
  }
  const existing =
    cart.find(
      item =>
        String(item.id) ===
        String(productId)
    );
  if (existing) {
    existing.quantity += 1;
  } else {
    cart.push({
      id: product.id,
      name: product.name,
      price: Number(
        product.price
      ),
      size:
        product.size || "",
      image_url:
        product.image_url || "",
      quantity: 1
    });
  }
  saveCart();
  updateBagButton();
  openCart();
}
/* =========================================================
   QUANTITY
========================================================= */
function changeQuantity(
  productId,
  amount
) {
  const item =
    cart.find(
      item =>
        String(item.id) ===
        String(productId)
    );
  if (!item) return;
  item.quantity += amount;
  if (item.quantity <= 0) {
    cart =
      cart.filter(
        item =>
          String(item.id) !==
          String(productId)
      );
  }
  saveCart();
  renderCart();
  updateBagButton();
}
function removeFromBag(productId) {
  cart =
    cart.filter(
      item =>
        String(item.id) !==
        String(productId)
    );
  saveCart();
  renderCart();
  updateBagButton();
}
/* =========================================================
   TOTALS
========================================================= */
function cartSubtotal() {
  return cart.reduce(
    (
      total,
      item
    ) =>
      total +
      Number(item.price) *
      Number(item.quantity),
    0
  );
}
function cartTotal() {
  if (!cart.length) {
    return 0;
  }
  return (
    cartSubtotal() +
    DELIVERY_FEE
  );
}
/* =========================================================
   BAG BUTTON
========================================================= */
function updateBagButton() {
  const button =
    document.querySelector(
      ".bag-button"
    );
  if (!button) return;
  const count =
    cart.reduce(
      (
        total,
        item
      ) =>
        total +
        Number(item.quantity),
      0
    );
  button.innerHTML =
    count > 0
      ? `♡ ${count}`
      : "♡";
}
/* =========================================================
   RENDER CART
========================================================= */
function renderCart() {
  const container =
    document.getElementById(
      "cart-items"
    );
  if (!container) return;
  if (!cart.length) {
    container.innerHTML = `
      <div class="empty-cart">
        <div style="
          font-size:45px;
          margin-bottom:15px;
        ">
          🍒
        </div>
        <p>
          Your bag is empty.
        </p>
        <button
          class="primary-button"
          onclick="
            closeCart();
            document
              .getElementById('shop')
              .scrollIntoView({behavior:'smooth'});
          "
        >
          Shop the drop →
        </button>
      </div>
    `;
    return;
  }
  let html = "";
  cart.forEach(item => {
    html += `
      <div class="cart-item">
        ${
          item.image_url
          ?
          `
            <img
              class="cart-image"
              src="${escapeHTML(item.image_url)}"
              alt="${escapeHTML(item.name)}"
            >
          `
          :
          `
            <div
              class="cart-image"
              style="
                display:flex;
                align-items:center;
                justify-content:center;
                font-size:25px;
              "
            >
              🍒
            </div>
          `
        }
        <div>
          <div class="cart-name">
            ${escapeHTML(
              item.name
            )}
          </div>
          ${
            item.size
            ?
            `
              <div class="cart-meta">
                Size:
                ${escapeHTML(
                  item.size
                )}
              </div>
            `
            :
            ""
          }
          <div class="cart-price">
            Rs.
            ${formatPrice(
              item.price
            )}
          </div>
          <div class="quantity-row">
            <button
              onclick="
                changeQuantity(
                  '${escapeHTML(item.id)}',
                  -1
                )
              "
            >
              −
            </button>
            <span>
              ${item.quantity}
            </span>
            <button
              onclick="
                changeQuantity(
                  '${escapeHTML(item.id)}',
                  1
                )
              "
            >
              +
            </button>
            <button
              class="remove"
              onclick="
                removeFromBag(
                  '${escapeHTML(item.id)}'
                )
              "
            >
              Remove
            </button>
          </div>
        </div>
      </div>
    `;
  });
  html += `
    <div class="summary">
      <div class="summary-row">
        <span>
          Subtotal
        </span>
        <span>
          Rs.
          ${formatPrice(
            cartSubtotal()
          )}
        </span>
      </div>
      <div class="summary-row">
        <span>
          Delivery
        </span>
        <span>
          Rs.
          ${formatPrice(
            DELIVERY_FEE
          )}
        </span>
      </div>
      <div class="summary-row summary-total">
        <span>
          Total
        </span>
        <span>
          Rs.
          ${formatPrice(
            cartTotal()
          )}
        </span>
      </div>
      <button
        class="primary-button"
        onclick="openCheckout()"
      >
        Proceed to Checkout →
      </button>
    </div>
  `;
  container.innerHTML =
    html;
}
/* =========================================================
   CART OPEN/CLOSE
========================================================= */
function openCart() {
  renderCart();
  document
    .getElementById(
      "cartOverlay"
    )
    .classList.add(
      "active"
    );
  document.body.classList.add(
    "no-scroll"
  );
}
function closeCart() {
  document
    .getElementById(
      "cartOverlay"
    )
    .classList.remove(
      "active"
    );
  document.body.classList.remove(
    "no-scroll"
  );
}
/* =========================================================
   CHECKOUT SUMMARY
========================================================= */
function renderCheckoutSummary() {
  const container =
    document.getElementById(
      "checkout-summary"
    );
  if (!container) return;
  let html = "";
  cart.forEach(item => {
    html += `
      <div class="summary-product">
        <span>
          ${escapeHTML(
            item.name
          )}
          × ${item.quantity}
        </span>
        <strong>
          Rs.
          ${formatPrice(
            item.price *
            item.quantity
          )}
        </strong>
      </div>
    `;
  });
  html += `
    <div class="summary-product">
      <span>
        Delivery
      </span>
      <strong>
        Rs.
        ${formatPrice(
          DELIVERY_FEE
        )}
      </strong>
    </div>
    <div class="checkout-total">
      <span>
        Total
      </span>
      <span>
        Rs.
        ${formatPrice(
          cartTotal()
        )}
      </span>
    </div>
  `;
  container.innerHTML =
    html;
}
/* =========================================================
   CHECKOUT
========================================================= */
function openCheckout() {
  if (!cart.length) {
    alert(
      "Your bag is empty 🍒"
    );
    return;
  }
  closeCart();
  renderCheckoutSummary();
  document
    .getElementById(
      "checkoutOverlay"
    )
    .classList.add(
      "active"
    );
  document.body.classList.add(
    "no-scroll"
  );
}
function closeCheckout() {
  document
    .getElementById(
      "checkoutOverlay"
    )
    .classList.remove(
      "active"
    );
  document.body.classList.remove(
    "no-scroll"
  );
}
/* =========================================================
   ORDER SUBMISSION
========================================================= */
async function submitOrder(event) {
  event.preventDefault();
  if (!cart.length) {
    alert(
      "Your bag is empty."
    );
    return;
  }
  const button =
    document.getElementById(
      "place-order-button"
    );
  button.disabled = true;
  button.textContent =
    "Submitting order...";
  const customerName =
    document
      .getElementById(
        "customer-name"
      )
      .value
      .trim();
  const customerPhone =
    document
      .getElementById(
        "customer-phone"
      )
      .value
      .trim();
  const customerCity =
    document
      .getElementById(
        "customer-city"
      )
      .value
      .trim();
  const customerAddress =
    document
      .getElementById(
        "customer-address"
      )
      .value
      .trim();
  const transactionId =
    document
      .getElementById(
        "transaction-id"
      )
      .value
      .trim();
  /*
    IMPORTANT:
    We generate the order UUID ourselves.
    This means we don't need:
      .select()
      .single()
    after the INSERT.
    Previously that could trigger another RLS
    problem because SELECT access is separate
    from INSERT access.
  */
  const orderId =
    crypto.randomUUID();
  const orderData = {
    id:
      orderId,
    customer_name:
      customerName,
    phone:
      customerPhone,
    address:
      customerAddress,
    city:
      customerCity,
    payment_method:
      "JazzCash",
    transaction_id:
      transactionId,
    total:
      cartTotal(),
    status:
      "pending"
  };
  try {
    /* -----------------------------------------------------
       INSERT ORDER
    ----------------------------------------------------- */
    const {
      error: orderError
    } =
      await supabaseClient
        .from("orders")
        .insert(orderData);
    if (orderError) {
      console.error(
        "ORDER INSERT ERROR:",
        orderError
      );
      alert(
        "ORDER ERROR:\n\n" +
        orderError.message
      );
      throw new Error(
        orderError.message
      );
    }
    /* -----------------------------------------------------
       INSERT ORDER ITEMS
    ----------------------------------------------------- */
    const items =
      cart.map(item => ({
        order_id:
          orderId,
        product_id:
          item.id,
        product_name:
          item.name,
        size:
          item.size || "",
        price:
          Number(item.price),
        quantity:
          Number(item.quantity)
      }));
    const {
      error: itemsError
    } =
      await supabaseClient
        .from("order_items")
        .insert(items);
    if (itemsError) {
      console.error(
        "ORDER ITEMS INSERT ERROR:",
        itemsError
      );
      alert(
        "ORDER ITEMS ERROR:\n\n" +
        itemsError.message
      );
      throw new Error(
        "The order was created, but the products could not be saved. Please contact Cherry Club."
      );
    }
    /* -----------------------------------------------------
       OPTIONAL EMAIL FUNCTION
    ----------------------------------------------------- */
    try {
      const {
        error: emailError
      } =
        await supabaseClient
          .functions
          .invoke(
            "smooth-worker",
            {
              body: {
                customer_name:
                  customerName,
                phone:
                  customerPhone,
                address:
                  customerAddress,
                city:
                  customerCity,
                transaction_id:
                  transactionId,
                total:
                  cartTotal(),
                order_id:
                  orderId
              }
            }
          );
      if (emailError) {
        console.error(
          "Email error:",
          emailError
        );
      }
    } catch (emailError) {
      console.error(
        "Email function error:",
        emailError
      );
    }
    /* -----------------------------------------------------
       SUCCESS
    ----------------------------------------------------- */
    cart = [];
    localStorage.removeItem(
      "cherryClubCart"
    );
    updateBagButton();
    document
      .getElementById(
        "checkout-form"
      )
      .reset();
    closeCheckout();
    document
      .getElementById(
        "success-order-id"
      )
      .textContent =
      "Order ID: " +
      orderId;
    document
      .getElementById(
        "successOverlay"
      )
      .classList.add(
        "active"
      );
    document.body.classList.add(
      "no-scroll"
    );
  } catch (error) {
    console.error(
      "Order submission error:",
      error
    );
    /*
      Don't show a second duplicate alert if
      the specific error was already displayed.
    */
  } finally {
    button.disabled =
      false;
    button.textContent =
      "Place Order →";
  }
}
