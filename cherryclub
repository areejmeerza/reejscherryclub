<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cherry Club 🍒</title>
  <meta name="description" content="Cherry Club — Y2K pieces, one-of-one finds & clothes worth obsessing over.">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    html {
      scroll-behavior: smooth;
    }
    body {
      background: #f5f1eb;
      color: #111;
      font-family: "DM Sans", sans-serif;
      overflow-x: hidden;
    }
    body.no-scroll {
      overflow: hidden;
    }
    button,
    input,
    textarea {
      font: inherit;
    }
    button {
      cursor: pointer;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    /* INTRO */
    .intro {
      position: fixed;
      inset: 0;
      z-index: 99999;
      background: #111;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      animation: introExit 1s ease forwards;
      animation-delay: 3.7s;
    }
    .cherry-stage {
      position: relative;
      width: 260px;
      height: 240px;
    }
    .cherry {
      position: absolute;
      width: 88px;
      height: 88px;
      background: #a20f20;
      border-radius: 50%;
      top: 90px;
      box-shadow:
        inset -12px -10px 0 rgba(0,0,0,.12),
        0 12px 35px rgba(162,15,32,.25);
    }
    .cherry.left {
      left: 10px;
      animation: cherryLeft 2s cubic-bezier(.7,0,.2,1) forwards;
    }
    .cherry.right {
      right: 10px;
      animation: cherryRight 2s cubic-bezier(.7,0,.2,1) forwards;
    }
    .cherry::before {
      content: "";
      position: absolute;
      width: 3px;
      height: 75px;
      background: #7a5b35;
      top: -55px;
      left: 51px;
      transform: rotate(-22deg);
      transform-origin: bottom;
    }
    .cherry.right::before {
      transform: rotate(22deg);
      left: 34px;
    }
    .cherry::after {
      content: "";
      position: absolute;
      width: 19px;
      height: 10px;
      background: #71844b;
      border-radius: 100% 0 100% 0;
      top: -59px;
      left: 50px;
      transform: rotate(-15deg);
    }
    .cherry.right::after {
      left: 20px;
      transform: rotate(15deg) scaleX(-1);
    }
    .intro-logo {
      position: absolute;
      color: white;
      text-align: center;
      opacity: 0;
      animation: logoReveal 1s ease forwards;
      animation-delay: 2.1s;
    }
    .intro-logo h1 {
      font-family: "Playfair Display", serif;
      font-size: clamp(50px, 11vw, 105px);
      font-weight: 500;
      font-style: italic;
      letter-spacing: -4px;
    }
    .intro-logo p {
      margin-top: 8px;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 5px;
      color: #aaa;
    }
    @keyframes cherryLeft {
      0% {
        transform: translateX(-150px) rotate(-25deg);
      }
      65% {
        transform: translateX(0) rotate(0);
      }
      78% {
        transform: translateX(5px) scale(1.15);
      }
      100% {
        transform: translateX(0) scale(1);
      }
    }
    @keyframes cherryRight {
      0% {
        transform: translateX(150px) rotate(25deg);
      }
      65% {
        transform: translateX(0) rotate(0);
      }
      78% {
        transform: translateX(-5px) scale(1.15);
      }
      100% {
        transform: translateX(0) scale(1);
      }
    }
    @keyframes logoReveal {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes introExit {
      to {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }
    }
    /* NAV */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 72px;
      padding: 0 5vw;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(245,241,235,.88);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(17,17,17,.08);
      z-index: 3000;
    }
    .menu-button,
    .bag-button {
      border: 0;
      background: none;
      color: #111;
    }
    .menu-button {
      display: flex;
      flex-direction: column;
      gap: 5px;
      width: 25px;
    }
    .menu-line {
      height: 1.5px;
      background: #111;
      width: 100%;
      transition: .25s;
    }
    .logo {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      font-family: "Playfair Display", serif;
      font-size: 23px;
      font-style: italic;
      white-space: nowrap;
    }
    .logo span {
      color: #a20f20;
    }
    .bag-button {
      font-size: 19px;
    }
    /* MENU */
    .menu-overlay {
      position: fixed;
      inset: 0;
      z-index: 5000;
      background: rgba(0,0,0,.45);
      opacity: 0;
      visibility: hidden;
      transition: .3s;
    }
    .menu-overlay.active {
      opacity: 1;
      visibility: visible;
    }
    .side-menu {
      width: min(410px, 90vw);
      height: 100%;
      background: #f5f1eb;
      padding: 100px 35px 40px;
      overflow-y: auto;
      transform: translateX(-100%);
      transition: .45s cubic-bezier(.7,0,.2,1);
    }
    .menu-overlay.active .side-menu {
      transform: translateX(0);
    }
    .close-menu {
      position: absolute;
      top: 25px;
      right: 25px;
      background: none;
      border: 0;
      font-size: 27px;
    }
    .menu-label {
      color: #888;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 3px;
      margin-bottom: 18px;
    }
    .menu-links {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .menu-links a,
    .menu-cart-link {
      font-family: "Playfair Display", serif;
      font-size: 29px;
      border: 0;
      background: none;
      text-align: left;
    }
    .menu-links a:hover,
    .menu-cart-link:hover {
      color: #a20f20;
      padding-left: 7px;
    }
    .menu-divider {
      height: 1px;
      background: #ddd7d0;
      margin: 32px 0;
    }
    .menu-small {
      display: flex;
      flex-direction: column;
      gap: 15px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }
    /* HERO */
    .hero {
      min-height: 100vh;
      padding: 140px 6vw 70px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
    }
    .hero-content {
      max-width: 900px;
    }
    .eyebrow {
      font-size: 10px;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: #777;
      margin-bottom: 25px;
    }
    .hero h2 {
      font-family: "Playfair Display", serif;
      font-size: clamp(60px,12vw,150px);
      line-height: .85;
      font-weight: 500;
      letter-spacing: -6px;
    }
    .hero h2 em {
      color: #a20f20;
      font-weight: 500;
    }
    .hero-text {
      max-width: 430px;
      margin: 35px auto 0;
      color: #666;
      line-height: 1.7;
      font-size: 14px;
    }
    .shop-button {
      display: inline-block;
      margin-top: 30px;
      padding: 17px 28px;
      background: #111;
      color: white;
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      transition: .3s;
    }
    .shop-button:hover {
      background: #a20f20;
      transform: translateY(-3px);
    }
    .scroll-note {
      position: absolute;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 9px;
      letter-spacing: 3px;
      color: #888;
      text-transform: uppercase;
    }
    /* MARQUEE */
    .marquee {
      background: #a20f20;
      color: white;
      overflow: hidden;
      white-space: nowrap;
      padding: 14px 0;
      font-size: 10px;
      letter-spacing: 3px;
    }
    .marquee-track {
      display: inline-block;
      animation: move 22s linear infinite;
    }
    .marquee span {
      margin: 0 28px;
    }
    @keyframes move {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-50%);
      }
    }
    /* PRODUCTS */
    .section {
      padding: 110px 6vw;
    }
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: end;
      margin-bottom: 45px;
    }
    .section-kicker {
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #777;
      margin-bottom: 12px;
    }
    .section-title {
      font-family: "Playfair Display", serif;
      font-size: clamp(48px,7vw,82px);
      font-weight: 500;
      letter-spacing: -3px;
    }
    .view-all {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 2px;
      border-bottom: 1px solid;
      padding-bottom: 5px;
    }
    .products {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 20px;
    }
    .product {
      cursor: pointer;
    }
    .product-image {
      aspect-ratio: 4 / 5;
      background: #ddd6cf;
      position: relative;
      overflow: hidden;
    }
    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: .45s;
    }
    .product:hover .product-image img {
      transform: scale(1.04);
    }
    .product-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: "Playfair Display", serif;
      font-size: 60px;
      color: rgba(17,17,17,.15);
    }
    .tag {
      position: absolute;
      top: 14px;
      left: 14px;
      background: white;
      padding: 7px 10px;
      font-size: 8px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      z-index: 2;
    }
    .product-info {
      padding: 15px 2px;
      display: flex;
      justify-content: space-between;
      gap: 15px;
    }
    .product-name {
      font-size: 13px;
    }
    .product-meta {
      font-size: 10px;
      color: #888;
      margin-top: 5px;
    }
    .price {
      font-size: 13px;
      white-space: nowrap;
    }
    /* ABOUT */
    .about {
      background: #111;
      color: white;
      padding: 120px 6vw;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10vw;
      align-items: center;
    }
    .about h2 {
      font-family: "Playfair Display", serif;
      font-size: clamp(50px,7vw,95px);
      line-height: .92;
      font-weight: 500;
      letter-spacing: -4px;
    }
    .about h2 em {
      color: #d83b4c;
    }
    .about-copy {
      max-width: 440px;
      color: #aaa;
      font-size: 14px;
      line-height: 1.9;
    }
    .about-copy strong {
      color: white;
    }
    /* CONTACT */
    .contact-section {
      padding: 110px 6vw;
      border-top: 1px solid #ddd7d0;
    }
    .contact-header {
      max-width: 650px;
      margin-bottom: 55px;
    }
    .contact-header h2 {
      font-family: "Playfair Display", serif;
      font-size: clamp(52px,7vw,90px);
      font-weight: 500;
      line-height: .95;
      letter-spacing: -4px;
    }
    .contact-header h2 em {
      color: #a20f20;
    }
    .contact-header p {
      max-width: 450px;
      margin-top: 25px;
      color: #666;
      font-size: 14px;
      line-height: 1.8;
    }
    .contact-grid {
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 1px;
      background: #d8d1ca;
      border: 1px solid #d8d1ca;
    }
    .contact-card {
      background: #f5f1eb;
      padding: 38px;
      min-height: 220px;
    }
    .contact-label {
      display: block;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 2.5px;
      color: #888;
      margin-bottom: 15px;
    }
    .contact-card h3 {
      font-family: "Playfair Display", serif;
      font-size: 28px;
      font-weight: 500;
      margin-bottom: 12px;
    }
    .contact-card p {
      color: #666;
      font-size: 12px;
      line-height: 1.7;
    }
    .contact-link {
      display: inline-block;
      margin-top: 22px;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1.8px;
      border-bottom: 1px solid;
      padding-bottom: 5px;
    }
    .policy-box {
      margin-top: 1px;
      padding: 45px 38px;
      background: #111;
      color: white;
      display: grid;
      grid-template-columns: .7fr 1.3fr;
      gap: 8vw;
    }
    .policy-box h3 {
      font-family: "Playfair Display", serif;
      font-size: 32px;
      font-weight: 500;
    }
    .policy-text {
      color: #aaa;
      font-size: 12px;
      line-height: 1.9;
    }
    .policy-text p + p {
      margin-top: 18px;
    }
    .policy-text strong {
      color: white;
    }
    /* FOOTER */
    footer {
      background: #111;
      color: white;
      border-top: 1px solid #333;
      padding: 60px 6vw 30px;
    }
    .footer-top {
      display: flex;
      justify-content: space-between;
      gap: 30px;
      padding-bottom: 60px;
    }
    .footer-logo {
      font-family: "Playfair Display", serif;
      font-size: 45px;
      font-style: italic;
    }
    .footer-links {
      display: flex;
      gap: 30px;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }
    .footer-bottom {
      border-top: 1px solid #333;
      padding-top: 22px;
      display: flex;
      justify-content: space-between;
      color: #777;
      font-size: 9px;
    }
    /* OVERLAYS */
    .store-overlay {
      position: fixed;
      inset: 0;
      z-index: 7000;
      background: rgba(0,0,0,.5);
      opacity: 0;
      visibility: hidden;
      transition: .3s;
    }
    .store-overlay.active {
      opacity: 1;
      visibility: visible;
    }
    .cart-drawer {
      position: absolute;
      right: 0;
      top: 0;
      height: 100%;
      width: min(450px,94vw);
      background: #f5f1eb;
      padding: 35px;
      overflow-y: auto;
      transform: translateX(100%);
      transition: .4s cubic-bezier(.7,0,.2,1);
    }
    .store-overlay.active .cart-drawer {
      transform: translateX(0);
    }
    .overlay-close {
      position: absolute;
      top: 20px;
      right: 25px;
      border: 0;
      background: none;
      font-size: 28px;
    }
    .drawer-title {
      font-family: "Playfair Display", serif;
      font-size: 42px;
      margin-bottom: 30px;
    }
    .empty-cart {
      padding: 80px 0;
      text-align: center;
      color: #777;
    }
    .cart-item {
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: 15px;
      padding: 18px 0;
      border-bottom: 1px solid #ddd7d0;
    }
    .cart-image {
      width: 80px;
      height: 100px;
      object-fit: cover;
      background: #ddd6cf;
    }
    .cart-name {
      font-size: 13px;
    }
    .cart-meta {
      color: #888;
      font-size: 10px;
      margin-top: 5px;
    }
    .cart-price {
      font-size: 12px;
      margin-top: 10px;
    }
    .quantity-row {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-top: 12px;
    }
    .quantity-row button {
      width: 25px;
      height: 25px;
      border: 1px solid #ccc;
      background: white;
    }
    .quantity-row .remove {
      width: auto;
      border: 0;
      background: none;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-left: 5px;
    }
    .summary {
      margin-top: 30px;
      border-top: 1px solid #111;
      padding-top: 20px;
    }
    .summary-row {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      margin-bottom: 12px;
    }
    .summary-total {
      border-top: 1px solid #ddd7d0;
      padding-top: 15px;
      font-size: 16px;
      font-weight: 600;
    }
    .primary-button {
      width: 100%;
      border: 0;
      background: #111;
      color: white;
      padding: 17px;
      margin-top: 20px;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 10px;
    }
    .primary-button:hover {
      background: #a20f20;
    }
    /* PRODUCT DETAIL */
    .product-modal {
      position: absolute;
      inset: 0;
      background: #f5f1eb;
      overflow-y: auto;
      padding: 100px 6vw 60px;
      transform: translateY(100%);
      transition: .45s cubic-bezier(.7,0,.2,1);
    }
    /* FIXED: product modal now opens when overlay gets .active */
    .store-overlay.active .product-modal {
      transform: translateY(0);
    }
    .product-modal-close {
      position: fixed;
      top: 25px;
      right: 35px;
      z-index: 10;
      border: 0;
      background: white;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      font-size: 24px;
    }
    .detail-grid {
      max-width: 1200px;
      margin: auto;
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 70px;
      align-items: start;
    }
    .detail-image {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      background: #ddd6cf;
    }
    .detail-info {
      padding-top: 30px;
      position: sticky;
      top: 30px;
    }
    .detail-category {
      color: #888;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 3px;
    }
    .detail-name {
      font-family: "Playfair Display", serif;
      font-size: clamp(45px,6vw,75px);
      line-height: .95;
      font-weight: 500;
      margin: 15px 0;
    }
    .detail-price {
      font-size: 18px;
      margin-bottom: 30px;
    }
    .detail-description {
      color: #666;
      font-size: 13px;
      line-height: 1.9;
      margin-bottom: 30px;
    }
    .detail-info-row {
      border-top: 1px solid #d8d1ca;
      padding: 15px 0;
      display: flex;
      justify-content: space-between;
      font-size: 11px;
    }
    .detail-info-row span:first-child {
      color: #888;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }
    .suggestions {
      max-width: 1200px;
      margin: 100px auto 0;
    }
    .suggestions h2 {
      font-family: "Playfair Display", serif;
      font-size: 45px;
      font-weight: 500;
      margin-bottom: 30px;
    }
    /* CHECKOUT */
    .checkout-modal {
      position: absolute;
      inset: 0;
      background: #f5f1eb;
      overflow-y: auto;
      padding: 90px 6vw 70px;
    }
    .checkout-inner {
      max-width: 850px;
      margin: auto;
    }
    .checkout-heading {
      font-family: "Playfair Display", serif;
      font-size: clamp(50px,7vw,80px);
      font-weight: 500;
      line-height: .95;
      margin-bottom: 45px;
    }
    .checkout-layout {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 45px;
    }
    .form-section {
      margin-bottom: 30px;
    }
    .form-section-title {
      font-family: "Playfair Display", serif;
      font-size: 25px;
      margin-bottom: 20px;
    }
    .field {
      margin-bottom: 16px;
    }
    .field label {
      display: block;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #777;
      margin-bottom: 7px;
    }
    .field input,
    .field textarea {
      width: 100%;
      padding: 13px;
      border: 1px solid #d4cec7;
      background: white;
      outline: none;
      font-size: 13px;
    }
    .field textarea {
      min-height: 100px;
      resize: vertical;
    }
    .payment-box {
      background: #111;
      color: white;
      padding: 25px;
      margin-top: 25px;
    }
    .payment-box h3 {
      font-family: "Playfair Display", serif;
      font-size: 29px;
      margin-bottom: 15px;
    }
    .payment-details {
      line-height: 2;
      font-size: 12px;
    }
    .payment-note {
      color: #aaa;
      font-size: 11px;
      line-height: 1.8;
      margin-top: 15px;
    }
    .order-summary-box {
      background: white;
      padding: 25px;
      height: fit-content;
      position: sticky;
      top: 25px;
    }
    .order-summary-box h3 {
      font-family: "Playfair Display", serif;
      font-size: 28px;
      margin-bottom: 20px;
    }
    .summary-product {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      font-size: 11px;
      padding: 12px 0;
      border-bottom: 1px solid #eee;
    }
